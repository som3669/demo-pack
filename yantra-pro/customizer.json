{
	"schema": 1,
	"theme_mods": {
		"custom_logo": { "image": "images/yantra-logo.png" },
		"yantra_logo_width": {
			"desktop": { "size": 32, "unit": "px" },
			"tablet": { "size": 30, "unit": "px" },
			"mobile": { "size": 28, "unit": "px" }
		},
		"yantra_header_builder": {
			"desktop": {
				"top": { "left": [], "center": [], "right": [] },
				"main": { "left": [ "logo" ], "center": [], "right": [ "primary-menu", "search", "button" ] },
				"bottom": { "left": [], "center": [], "right": [] }
			},
			"mobile": {
				"top": { "left": [], "center": [], "right": [] },
				"main": { "left": [ "logo" ], "center": [], "right": [ "search", "toggle" ] },
				"bottom": { "left": [], "center": [], "right": [] }
			},
			"offset": [ "mobile-menu", "button", "socials" ]
		},
		"yantra_header_button_text": "Get started",
		"yantra_header_button_url": { "page_url": "pricing" },
		"yantra_header_socials": [
			{ "label": "X", "url": "https://example.com/yantra-on-x", "icon": "fa-brands fa-x-twitter", "network": "x" },
			{ "label": "LinkedIn", "url": "https://example.com/yantra-on-linkedin", "icon": "fa-brands fa-linkedin", "network": "linkedin" },
			{ "label": "YouTube", "url": "https://example.com/yantra-on-youtube", "icon": "fa-brands fa-youtube", "network": "youtube" },
			{ "label": "Instagram", "url": "https://example.com/yantra-on-instagram", "icon": "fa-brands fa-instagram", "network": "instagram" }
		],
		"themor_sticky_header": true,
		"themor_site_announce": true,
		"themor_site_announce_text": "New: Click any part of your site to edit it.",
		"themor_site_announce_label": "See what is new",
		"themor_site_announce_url": { "post_url": "what-is-new-this-autumn" },
		"themor_site_announce_close": true,
		"themor_site_announce_bg": "#0f172a",
		"themor_site_announce_color": "#e2e8f0",
		"yantra_footer_builder": {
			"desktop": {
				"top": { "top-1": [], "top-2": [], "top-3": [], "top-4": [], "top-5": [], "top-6": [] },
				"main": { "main-1": [ "widget-1", "socials" ], "main-2": [ "widget-2" ], "main-3": [ "widget-3" ], "main-4": [ "widget-4" ], "main-5": [], "main-6": [] },
				"bottom": { "bottom-1": [ "copyright" ], "bottom-2": [ "footer-menu" ], "bottom-3": [], "bottom-4": [], "bottom-5": [], "bottom-6": [] }
			}
		},
		"yantra_footer_socials": [
			{ "label": "X", "url": "https://example.com/yantra-on-x", "icon": "fa-brands fa-x-twitter", "network": "x" },
			{ "label": "LinkedIn", "url": "https://example.com/yantra-on-linkedin", "icon": "fa-brands fa-linkedin", "network": "linkedin" },
			{ "label": "YouTube", "url": "https://example.com/yantra-on-youtube", "icon": "fa-brands fa-youtube", "network": "youtube" },
			{ "label": "Instagram", "url": "https://example.com/yantra-on-instagram", "icon": "fa-brands fa-instagram", "network": "instagram" }
		],
		"yantra_title_style": "banner",
		"yantra_breadcrumbs_position": "above",
		"yantra_breadcrumbs_separator": "chevron",
		"yantra_blog_elements": [ "image", "categories", "title", "meta", "excerpt", "read-more" ],
		"yantra_pagination_style": "load-more",
		"yantra_post_footer_elements": [ "tags", "author-box", "navigation", "related" ],
		"themor_blog_progress": true,
		"themor_blog_related_title": "Keep reading"
	}
}
