{
	"schema": 1,
	"theme_mods": {
		"custom_logo": { "image": "images/daybook-logo.png" },
		"yantra_logo_width": {
			"desktop": { "size": 32, "unit": "px" },
			"tablet": { "size": 30, "unit": "px" },
			"mobile": { "size": 28, "unit": "px" }
		},
		"yantra_site_title_typography": {
			"font-family": "Outfit",
			"font-weight": "700",
			"font-size": { "desktop": { "size": 26, "unit": "px" }, "mobile": { "size": 22, "unit": "px" } },
			"letter-spacing": { "desktop": { "size": -0.035, "unit": "em" } }
		},

		"yantra_color_palette": {
			"id": "custom",
			"name": "Daybook",
			"colors": {
				"yantra-color-1": "#d63b1f",
				"yantra-color-2": "#b02e15",
				"yantra-color-3": "#14161a",
				"yantra-color-4": "#3f444b",
				"yantra-color-5": "#676c74",
				"yantra-color-6": "#e4e4e0",
				"yantra-color-7": "#f4f4f1",
				"yantra-color-8": "#ffffff",
				"yantra-color-9": "#ffffff"
			}
		},
		"themor_dark_mode": "toggle",
		"themor_dark_mode_toggle_place": "none",
		"themor_dark_palette": {
			"id": "custom",
			"name": "Daybook dark",
			"colors": {
				"yantra-color-1": "#ff7a59",
				"yantra-color-2": "#ff9b80",
				"yantra-color-3": "#f4f4f1",
				"yantra-color-4": "#c9cbcf",
				"yantra-color-5": "#9a9ea6",
				"yantra-color-6": "#2a2d33",
				"yantra-color-7": "#1a1c20",
				"yantra-color-8": "#111214",
				"yantra-color-9": "#111214"
			}
		},

		"yantra_body_typography": {
			"font-family": "DM Sans",
			"font-weight": "400",
			"font-style": "default",
			"text-transform": "default",
			"font-size": { "desktop": { "size": 17, "unit": "px" } },
			"line-height": { "desktop": { "size": 1.7, "unit": "-" } }
		},
		"yantra_heading_typography": {
			"font-family": "Outfit",
			"font-weight": "600",
			"font-style": "default",
			"text-transform": "default",
			"line-height": { "desktop": { "size": 1.12, "unit": "-" } },
			"letter-spacing": { "desktop": { "size": -0.03, "unit": "em" } }
		},
		"yantra_menu_typography": {
			"font-weight": "500",
			"text-transform": "default",
			"font-size": { "desktop": { "size": 16, "unit": "px" } }
		},
		"yantra_radius": { "size": 16, "unit": "px" },
		"yantra_box_radius": { "size": 24, "unit": "px" },
		"yantra_button_radius": { "size": 100, "unit": "px" },

		"yantra_header_builder": {
			"desktop": {
				"top": { "left": [ "clock", "icon-text" ], "center": [], "right": [ "socials" ] },
				"main": { "left": [ "logo" ], "center": [ "primary-menu" ], "right": [ "search", "color-scheme", "button" ] },
				"bottom": { "left": [], "center": [], "right": [] }
			},
			"mobile": {
				"top": { "left": [], "center": [], "right": [] },
				"main": { "left": [ "logo" ], "center": [], "right": [ "color-scheme", "toggle" ] },
				"bottom": { "left": [], "center": [], "right": [] }
			},
			"offset": [ "mobile-menu", "button", "socials" ]
		},
		"yantra_header_top_background": {
			"background-color": "#14161a",
			"background-image": "",
			"background-repeat": "no-repeat",
			"background-position": "center center",
			"background-size": "cover",
			"background-attachment": "scroll"
		},
		"yantra_header_top_color": "#e9e9e6",
		"yantra_header_top_border": false,
		"yantra_header_main_height": {
			"desktop": { "size": 76, "unit": "px" },
			"tablet": { "size": 68, "unit": "px" },
			"mobile": { "size": 64, "unit": "px" }
		},
		"yantra_pro_clock_show": "date",
		"yantra_pro_icon_text_icon": "fa-solid fa-sun",
		"yantra_pro_icon_text_text": "New stories every Sunday morning",
		"yantra_header_button_text": "Start here",
		"yantra_header_button_url": { "page_url": "about" },
		"yantra_header_socials": [
			{ "label": "Instagram", "url": "https://example.com/daybook-on-instagram", "icon": "fa-brands fa-instagram", "network": "instagram" },
			{ "label": "Pinterest", "url": "https://example.com/daybook-on-pinterest", "icon": "fa-brands fa-pinterest", "network": "pinterest" },
			{ "label": "YouTube", "url": "https://example.com/daybook-on-youtube", "icon": "fa-brands fa-youtube", "network": "youtube" }
		],
		"themor_sticky_header": true,
		"themor_sticky_header_hide": true,
		"themor_sticky_header_shrink": true,
		"yantra_pro_scroll_bar": true,
		"yantra_pro_smooth_scroll": true,

		"yantra_footer_builder": {
			"desktop": {
				"top": { "top-1": [], "top-2": [], "top-3": [], "top-4": [], "top-5": [], "top-6": [] },
				"main": { "main-1": [ "widget-1", "socials" ], "main-2": [ "widget-2" ], "main-3": [ "widget-3" ], "main-4": [ "widget-4" ], "main-5": [], "main-6": [] },
				"bottom": { "bottom-1": [ "copyright" ], "bottom-2": [ "footer-menu" ], "bottom-3": [], "bottom-4": [], "bottom-5": [], "bottom-6": [] }
			}
		},
		"yantra_footer_main_background": {
			"background-color": "#14161a",
			"background-image": "",
			"background-repeat": "no-repeat",
			"background-position": "center center",
			"background-size": "cover",
			"background-attachment": "scroll"
		},
		"yantra_footer_bottom_background": {
			"background-color": "#14161a",
			"background-image": "",
			"background-repeat": "no-repeat",
			"background-position": "center center",
			"background-size": "cover",
			"background-attachment": "scroll"
		},
		"yantra_footer_main_color": "#c9cbcf",
		"yantra_footer_bottom_color": "#9a9ea6",
		"yantra_footer_main_border": false,
		"yantra_footer_bottom_border": false,
		"yantra_footer_copyright": "© {year} {site}. New stories every Sunday.",
		"yantra_footer_socials": [
			{ "label": "Instagram", "url": "https://example.com/daybook-on-instagram", "icon": "fa-brands fa-instagram", "network": "instagram" },
			{ "label": "Pinterest", "url": "https://example.com/daybook-on-pinterest", "icon": "fa-brands fa-pinterest", "network": "pinterest" },
			{ "label": "YouTube", "url": "https://example.com/daybook-on-youtube", "icon": "fa-brands fa-youtube", "network": "youtube" }
		],

		"yantra_title_style": "banner",
		"yantra_title_align": "start",
		"yantra_breadcrumbs_position": "above",
		"yantra_breadcrumbs_separator": "slash",

		"yantra_blog_layout": "masonry",
		"yantra_blog_columns": "3",
		"yantra_blog_card_style": "plain",
		"yantra_blog_elements": [ "image", "categories", "title", "excerpt", "meta" ],
		"yantra_blog_meta": [ "date", "reading-time", "views" ],
		"yantra_image_ratio": "auto",
		"yantra_excerpt_length": 20,
		"yantra_pagination_style": "infinite",
		"themor_blog_featured": true,
		"themor_blog_featured_source": "sticky",
		"themor_blog_featured_count": 4,

		"yantra_post_header_style": "hero",
		"yantra_post_meta": [ "author", "date", "reading-time", "views" ],
		"yantra_post_footer_elements": [ "tags", "author-box", "navigation", "related" ],
		"yantra_sidebar_post": "narrow",
		"themor_blog_progress": true,
		"themor_blog_toc": true,
		"themor_blog_toc_depth": "h3",
		"themor_blog_toc_min": 3,
		"themor_blog_share": true,
		"themor_blog_share_float": true,
		"themor_blog_related": true,
		"themor_blog_related_title": "Keep reading",
		"themor_blog_views": true,
		"themor_blog_author_header": true,
		"themor_blog_formats": true,
		"themor_blog_series": true,
		"themor_blog_series_place": "top",

		"themor_mbar_on": true,
		"themor_mbar_items": [ "home", "search", "custom", "menu" ],
		"themor_mbar_custom_label": "Start here",
		"themor_mbar_custom_icon": "fa-solid fa-sun",
		"themor_mbar_custom_url": { "page_url": "about" },
		"themor_mbar_hide_on_scroll": true
	}
}
